#!/usr/bin/env bash
# The shared portable command tree owns parsing/help; no source is queried
# until it resolves a valid invocation. Missing installation is not fallback
# permission to execute a backend with unvalidated arguments.
set -euo pipefail
YGGBIN="${YGG_BIN_DIR:-$HOME/.yggterm/bin/ygg}"
if [ ! -r "$YGGBIN/ygg-inspect.py" ] || [ ! -r "$YGGBIN/ygg_command_tree.py" ]; then
  echo 'ygg: command catalog unavailable; refresh with ygg-disperse.py install' >&2
  exit 3
fi
exec python3 "$YGGBIN/ygg-inspect.py" "$@"
