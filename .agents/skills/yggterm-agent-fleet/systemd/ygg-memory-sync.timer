[Unit]
Description=Yggterm memory recovery catch-up (managed CLI startup is immediate)

[Timer]
# ⛔ OnStartupSec, NOT OnBootSec. Boot-relative elapses are measured from the
# KERNEL boot, but the user manager (and this timer with it) arms tens of
# seconds AFTER boot — ~40s here vs OnBootSec=15s. systemd skips an elapse
# already in the past, and with no prior service run OnUnitActiveSec has
# nothing to anchor to: the timer sits 'active (elapsed)' with
# NextElapseUSecMonotonic=infinity FOREVER while reporting healthy. A fleet
# seat's tick died exactly this way 2026-08-22..2026-10-18 (heartbeat stale,
# the single-host dreamer blind to that harness's quiescence); a second host
# died the same way 2026-09-26.
# OnStartupSec is manager-relative, so it is always in the future when the
# timer arms.
OnStartupSec=15s
OnUnitActiveSec=60s
AccuracySec=5s
RandomizedDelaySec=10s
Persistent=true

[Install]
WantedBy=timers.target
