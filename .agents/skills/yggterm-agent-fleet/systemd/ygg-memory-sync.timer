[Unit]
Description=Yggterm memory recovery catch-up (managed CLI startup is immediate)

[Timer]
# ⛔ OnCalendar, NOT OnBootSec/OnStartupSec/OnUnitActiveSec (owner 2026-10-18,
# second death same day). Boot/manager-relative elapses get SKIPPED when the
# user manager arms the timer after boot+15s already passed (boot-skip: one
# seat's tick ran dead 8 weeks while reporting healthy), and the monotonic
# OnUnitActiveSec leg decays again on long-lived managers (failed oneshot
# runs + daemon-reload re-computation left NextElapseUSecMonotonic=infinity
# within hours of the morning fix — caught by the doctor's dead-shape probe
# the same afternoon). A wall-clock schedule ALWAYS yields a next elapse;
# that is the ygg-panic.timer lesson, now applied here too. Every minute at
# :30, deliberately off the :00/:43/:17 jobs.
OnCalendar=*-*-* *:*:30
AccuracySec=5s
RandomizedDelaySec=5s
Persistent=true

[Install]
WantedBy=timers.target
