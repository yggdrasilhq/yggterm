{
  "schema_version": 1,
  "option_sets": {
    "json": [
      {
        "flags": [
          "--json"
        ],
        "help": "Emit a versioned machine-readable result.",
        "action": "store_true"
      }
    ],
    "common": [
      {
        "$ref": "json"
      },
      {
        "flags": [
          "--host"
        ],
        "help": "Host name or all (configured enrollment only)."
      },
      {
        "flags": [
          "--since"
        ],
        "help": "Relative age, such as 7d, or an absolute timestamp."
      },
      {
        "flags": [
          "--until"
        ],
        "help": "Absolute timestamp or future duration, such as +7d."
      },
      {
        "flags": [
          "--limit"
        ],
        "help": "Maximum result rows.",
        "default": "50"
      },
      {
        "flags": [
          "--cursor"
        ],
        "help": "Continue a page of the same snapshot."
      },
      {
        "flags": [
          "--snapshot"
        ],
        "help": "Read an immutable retained snapshot ID."
      }
    ],
    "dream_filters": [
      {
        "flags": [
          "--state"
        ],
        "help": "Match attempt states; repeats are OR.",
        "action": "append",
        "choices": [
          "planned",
          "scheduled",
          "queued",
          "running",
          "failed",
          "completed",
          "cancelled",
          "interrupted",
          "unknown",
          "retry_wait",
          "cooldown_wait"
        ]
      },
      {
        "flags": [
          "--review"
        ],
        "help": "Composer disposition.",
        "choices": [
          "unreviewed",
          "investigating",
          "repair-proposed",
          "repair-running",
          "awaiting-verification",
          "verified",
          "false-positive",
          "deferred"
        ]
      }
    ]
  },
  "commands": [
    {
      "path": [],
      "summary": "Inspect and operate the swarm. Type a noun to learn the next word.",
      "options": []
    },
    {
      "path": [
        "dream"
      ],
      "summary": "Inspect autonomous work, attempts and their evidence.",
      "options": []
    },
    {
      "path": [
        "dream",
        "ps"
      ],
      "summary": "Show active dream attempts.",
      "handler": "query",
      "options": [
        {
          "$ref": "common"
        }
      ]
    },
    {
      "path": [
        "dream",
        "ls"
      ],
      "summary": "Browse planned, current and historical dreams.",
      "handler": "query",
      "options": [
        {
          "$ref": "common"
        },
        {
          "$ref": "dream_filters"
        },
        {
          "flags": [
            "--all"
          ],
          "help": "Include retained attempt history.",
          "action": "store_true"
        }
      ],
      "examples": [
        {
          "title": "Find failed dreams not examined by the composer",
          "command": "ygg dream ls --all --state failed --review unreviewed --since 7d",
          "tags": "failures history composer"
        }
      ]
    },
    {
      "path": [
        "dream",
        "inspect"
      ],
      "summary": "Explain a work item, its retries and repair history.",
      "handler": "query",
      "options": [
        {
          "$ref": "common"
        },
        {
          "flags": [
            "--attempts"
          ],
          "help": "Include every retained attempt.",
          "action": "store_true"
        },
        {
          "flags": [
            "--repairs"
          ],
          "help": "Include linked composer notes and repair outcomes.",
          "action": "store_true"
        }
      ],
      "operand": "id",
      "examples": [
        {
          "title": "Trace a failed work item through retries and repairs",
          "command": "ygg dream inspect dream-42 --attempts --repairs",
          "tags": "history evidence"
        }
      ]
    },
    {
      "path": [
        "dream",
        "logs"
      ],
      "summary": "Read evidence for an exact dream attempt.",
      "handler": "query",
      "options": [
        {
          "$ref": "common"
        },
        {
          "flags": [
            "--attempt"
          ],
          "help": "Exact attempt ID."
        }
      ],
      "operand": "id",
      "examples": [
        {
          "title": "Read the failed attempt, not a later retry",
          "command": "ygg dream logs dream-42 --attempt attempt-3",
          "tags": "failure logs"
        }
      ]
    },
    {
      "path": [
        "dream",
        "open"
      ],
      "summary": "Select and inspect a live session or read-only transcript.",
      "effect": "attach",
      "handler": "open",
      "options": [
        {
          "$ref": "common"
        },
        {
          "$ref": "dream_filters"
        },
        {
          "flags": [
            "--pick"
          ],
          "help": "Choose interactively; never resumes work.",
          "action": "store_true"
        },
        {
          "flags": [
            "--attempt"
          ],
          "help": "Exact attempt ID."
        }
      ],
      "operand": "id",
      "optional_operand": true,
      "examples": [
        {
          "title": "Select a failed attempt for human inspection",
          "command": "ygg dream open --pick --state failed",
          "tags": "picker session harness"
        }
      ]
    },
    {
      "path": [
        "dream",
        "status"
      ],
      "summary": "Existing orchestrator status (compatibility).",
      "handler": "legacy",
      "options": [
        {
          "$ref": "json"
        }
      ],
      "examples": [
