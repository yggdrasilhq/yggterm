    {
      "path": [
        "service",
        "top"
      ],
      "summary": "Show compute ownership without counting shared resources twice.",
      "handler": "query",
      "options": [
        {
          "$ref": "common"
        },
        {
          "flags": [
            "--by"
          ],
          "help": "Group resource ownership.",
          "choices": [
            "dream",
            "service",
            "host"
          ],
          "default": "dream"
        }
      ],
      "examples": [
        {
          "title": "Compare dreamer compute",
          "command": "ygg service top --by dream",
          "tags": "cpu memory resources"
        }
      ]
    },
    {
      "path": [
        "service",
        "logs"
      ],
